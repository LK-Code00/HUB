local api=startHub()
local hub=environment.ZyonHub
local settings=api.settings
local guide=named('FovGuide')
local handle=named('FovDragHandle')
local lock=control('Travar posicao')
local x=control('POSICAO HORIZONTAL · X')
local y=control('POSICAO VERTICAL · Y')

test('initial guide and locked controls',function()
    assert(settings.FOVLocked and guide.Visible and not handle.Visible)
    assert(not x.Active and not y.Active)
    near(guide.Position.X.Offset,500); near(guide.Position.Y.Offset,400)
    near(guide.Size.X.Offset,368)
end)
test('unlock, pause aiming, and reveal editing controls',function()
    press(lock)
    assert(not settings.FOVLocked and handle.Visible and x.Active and y.Active)
    assert(named('FovEditBar').Visible)
    -- The camera double has no Lerp method: a mistaken aim pass would error.
    hub.Target={Parent={}}
    runService.bindings.ZYON_SMOOTH_AIM_V9(1)
    assert(hub.Target==nil)
    hub.Target=nil
end)
test('mouse drag moves the guide and clamps to viewport',function()
    local mouse=pointer('MouseButton1',500,400)
    handle.InputBegan:Fire(mouse)
    input.InputChanged:Fire(pointer('MouseMovement',700,240))
    near(settings.FOVX,0.7); near(settings.FOVY,0.3)
    near(guide.Position.X.Offset,700); near(guide.Position.Y.Offset,240)
    input.InputChanged:Fire(pointer('MouseMovement',2000,-500))
    near(settings.FOVX,1); near(settings.FOVY,0)
    assert(handle.Position.X.Offset<=952 and handle.Position.Y.Offset>=0)
    input.InputEnded:Fire(mouse)
    press(byText('CENTRALIZAR FOV'))
    near(settings.FOVX,0.5); near(settings.FOVY,0.5)
end)
test('lock cancels an active drag and prevents all position edits',function()
    local mouse=pointer('MouseButton1',500,400)
    handle.InputBegan:Fire(mouse)
    press(byText('TRAVAR'))
    assert(settings.FOVLocked and not handle.Visible and not named('FovEditBar').Visible)
    input.InputChanged:Fire(pointer('MouseMovement',900,700))
    x.InputBegan:Fire(pointer('MouseButton1',x.AbsolutePosition.X,0))
    press(byText('CENTRALIZAR FOV'))
    near(settings.FOVX,0.5); near(settings.FOVY,0.5)
    input.InputEnded:Fire(mouse)
end)
test('touch ownership ignores a second finger and releases correctly',function()
    press(lock)
    local first=pointer('Touch',500,400)
    local second=pointer('Touch',900,700)
    handle.InputBegan:Fire(first)
    handle.InputBegan:Fire(second)
    input.InputChanged:Fire(second)
    near(settings.FOVX,0.5)
    first.Position=vec(600,480)
    input.InputChanged:Fire(first)
    near(settings.FOVX,0.6); near(settings.FOVY,0.6)
    input.InputEnded:Fire(second)
    first.Position=vec(700,560)
    input.InputChanged:Fire(first)
    near(settings.FOVX,0.7)
    input.InputEnded:Fire(first)
    first.Position=vec(800,640)
    input.InputChanged:Fire(first)
    near(settings.FOVX,0.7)
end)
test('coordinate sliders, target invalidation, and scroll recovery',function()
    hub.Target={}
    local mouse=pointer('MouseButton1',x.AbsolutePosition.X+x.AbsoluteSize.X*0.25,0)
    x.InputBegan:Fire(mouse)
    near(settings.FOVX,0.25)
    assert(hub.Target==nil and not named('fovPage').ScrollingEnabled)
    input.InputEnded:Fire(mouse)
    assert(named('fovPage').ScrollingEnabled)
    mouse=pointer('MouseButton1',y.AbsolutePosition.X+y.AbsoluteSize.X*0.75,0)
    y.InputBegan:Fire(mouse)
    input.InputEnded:Fire(mouse)
    near(settings.FOVY,0.75)
    press(lock)
end)
test('rotation preserves normalized locked position and window bounds',function()
    objects.viewport=vec(800,400); camera.ViewportSize=objects.viewport
    camera:GetPropertyChangedSignal('ViewportSize'):Fire()
    near(guide.Position.X.Offset,200); near(guide.Position.Y.Offset,300)
    near(settings.FOVX,0.25); near(settings.FOVY,0.75)
    local main=named('Hub')
    assert(main.AbsoluteSize.Y<=376 and main.AbsoluteSize.X<=776)
    assert(main.Position.X.Offset+main.AbsoluteSize.X<=800)
    assert(main.Position.Y.Offset+main.AbsoluteSize.Y<=400)
end)
test('new camera is observed and old camera disconnected',function()
    local old=camera
    camera=Instance.new('Camera'); camera.ViewportSize=vec(400,800)
    camera.CFrame={Position=vec(0,0,0)}
    function camera:WorldToViewportPoint(position) return position,true end
    objects.viewport=camera.ViewportSize
    workspace.CurrentCamera=camera
    workspace:GetPropertyChangedSignal('CurrentCamera'):Fire()
    near(guide.Position.X.Offset,100); near(guide.Position.Y.Offset,600)
    for _,connection in ipairs(old:GetPropertyChangedSignal('ViewportSize').connections) do
        assert(not connection.Connected)
    end
end)
test('target acquisition uses the moved guide center',function()
    settings.FOV=0.1
    local function enemyPlayer(id,position)
        local player=Instance.new('Player')
        player.Name='Opponent'..id; player.DisplayName=player.Name; player.UserId=id
        -- The service test double is not an Instance, so assign this pointer directly.
        player._props.Parent=players
        local character=Instance.new('Model'); character.Parent=workspace; player.Character=character
        local head=Instance.new('Part'); head.Name='Head'; head.Position=position; head.Parent=character
        local humanoid=Instance.new('Humanoid'); humanoid.Health=100; humanoid.Parent=character
        table.insert(players.list,player)
        hub.Friends[id]='other'; hub.Relations[id]='enemy'
        return head
    end
    local moved=enemyPlayer(2,vec(100,600,10))
    enemyPlayer(3,vec(200,400,10))
    settings.MaxDistance=10000
    api.refreshTeamCache()
    hub.Target=nil
    assert(api.findTarget()==moved)
end)
test('hiding the guide exits editing and aim off still allows editing',function()
    press(lock)
    press(control('Mostrar circulo'))
    assert(settings.FOVLocked and not guide.Visible and not handle.Visible)
    press(control('Aimbot'))
    press(lock)
    assert(not settings.Aim and settings.ShowFOV and guide.Visible)
    press(lock)
    assert(not guide.Visible)
end)
test('focus loss locks and ends slider gestures',function()
    press(lock)
    local mouse=pointer('MouseButton1',x.AbsolutePosition.X,0)
    x.InputBegan:Fire(mouse)
    input.WindowFocusReleased:Fire()
    assert(settings.FOVLocked and named('fovPage').ScrollingEnabled)
    local before=settings.FOVX
    input.InputChanged:Fire(pointer('MouseMovement',1000,0))
    near(settings.FOVX,before)
end)
test('tabs, themes, roster, and minimize remain usable',function()
    press(byText('JOGADORES'))
    assert(named('playersPage').Visible and not named('aimPage').Visible)
    assert(byText('Opponent2'))
    press(byText('VISUAL'))
    press(byText('AZUL'))
    assert(byText('• AZUL'))
    near(guide:FindFirstChildOfClass('UIStroke').Color,Color3.fromRGB(83,185,255))
    press(byText('−'))
    assert(hub.Minimized and not named('Hub').Visible and named('CollapsedHub').Visible)
    press(named('CollapsedHub'))
    assert(not hub.Minimized and named('Hub').Visible)
end)
test('re-running cleans up the old GUI and input connections',function()
    local oldHub=hub
    api=startHub()
    hub=environment.ZyonHub
    assert(oldHub~=hub and not oldHub.Running and oldHub.Screen.Destroyed)
    for _,connection in ipairs(oldHub.Connections) do assert(not connection.Connected) end
    assert(runService.bindings.ZYON_SMOOTH_AIM_V9)
end)
test('close is idempotent and releases all tracked resources',function()
    press(byText('×'))
    assert(not hub.Running and hub.Screen.Destroyed and environment.ZyonHub==nil)
    assert(runService.bindings.ZYON_SMOOTH_AIM_V9==nil)
    for _,connection in ipairs(hub.Connections) do assert(not connection.Connected) end
    hub.Stop()
end)

